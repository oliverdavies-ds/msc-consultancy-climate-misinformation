# Data: only the label only release, the manifest and the notes are tracked.
# Source text (news articles, think tank reports) is not redistributed.
data/*
!data/README.md
!data/export_labels.py
!data/think_tank_manifest.xlsx
!data/public/

# LoRA adapter weights exceed the GitHub file size limit. Only the config is tracked.
finetuning/adapter/*
!finetuning/adapter/adapter_config.json

# Training checkpoints
outputs/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/

# R
.RData
.Rhistory
.Rproj.user/

# Secrets and OS files
.env
.DS_Store
